# Database
DATABASE_URL=postgresql://jobmap:password@localhost:5432/jobmap

# Google OAuth Configuration
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=636597585856-8mut7gqkncb3tkj2vqgbelu9t5tbscq7.apps.googleusercontent.com

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your_secure_random_jwt_secret_here_generate_with_openssl
JWT_REFRESH_SECRET=your_secure_random_refresh_secret_here_generate_with_openssl

# Application Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug

# CORS Origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Email Configuration (optional, for future use)
# SENDGRID_API_KEY=your_sendgrid_api_key
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_email_password

# Redis (optional, for caching/session management)
# REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
